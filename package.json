{
  "name": "firststory",
  "private": true,
  "type": "module",
  "description": "Скрипти генерації і збирання фільмів за історіями Контакт2U",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit -p scripts",
    "test": "node --import tsx --test --test-reporter=spec \"scripts/test/*.test.ts\"",
    "estimate": "tsx scripts/estimate.ts",
    "voice-previews": "tsx scripts/voice-previews.ts",
    "narrate": "tsx scripts/narrate.ts",
    "character-sheets": "tsx scripts/character-sheets.ts",
    "upload-character-sheet": "tsx scripts/upload-character-sheet.ts",
    "frames": "tsx scripts/frames.ts",
    "sound": "tsx scripts/sound.ts",
    "review": "tsx scripts/review.ts"
  },
  "dependencies": {
    "sharp": "^0.34.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
